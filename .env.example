# Export these in your shell; this application does not automatically load .env.
# Use a long random value for a shared deployment. Local development generates
# an ignored instance/.session-key when SECRET_KEY is not set.
SECRET_KEY=
# Set to 1 only when serving over HTTPS.
COOKIE_SECURE=0
PORT=5000
# Optional absolute directory outside the public repository:
# APP_DATA_DIR=/private/path/academic-planning/students
